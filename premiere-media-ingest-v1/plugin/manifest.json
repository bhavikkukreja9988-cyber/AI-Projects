{
  "manifestVersion": 5,
  "id": "com.bhavik.mediaingest.uxp",
  "name": "Media Ingest",
  "version": "1.1.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "network": {
      "domains": "all"
    },
    "launchProcess": {
      "extensions": [""],
      "schemes": []
    }
  },
  "entrypoints": [
    {
      "id": "mediaIngestPanel",
      "type": "panel",
      "label": {
        "default": "Media Ingest"
      },
      "minimumSize": {
        "width": 360,
        "height": 760
      },
      "preferredDockedSize": {
        "width": 420,
        "height": 800
      },
      "preferredFloatingSize": {
        "width": 460,
        "height": 850
      }
    }
  ]
}
